{
  "expo": {
    "name": "Digital Signboard",
    "slug": "digital-signboard",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/led.png",
    "scheme": "digitalsignboard",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "bundleIdentifier": "com.yourname.digitalsignboard",
      "associatedDomains": ["applinks:YOUR_DOMAIN.example"]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000"
      },
      "package": "com.yourname.digitalsignboard",
      "permissions": [],
      "softwareKeyboardLayoutMode": "pan",
      "intentFilters": [{
        "action": "VIEW",
        "autoVerify": true,
        "data": [{ "scheme": "https", "host": "YOUR_DOMAIN.example", "pathPrefix": "/join" }],
        "category": ["BROWSABLE", "DEFAULT"]
      }]
    },
    "web": {},
    "platforms": ["ios", "android", "web"],
      "assetBundlePatterns": [
      "**/*"
    ],
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#000000"
    },
    "androidNavigationBar": {
      "barStyle": "light-content",
      "backgroundColor": "#000000"
    }
  }
}
