{
  "expo": {
    "name": "Digital Signboard",
    "slug": "digital-signboard",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/led.png",
    "scheme": "digitalsignboard",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "bundleIdentifier": "com.yourname.digitalsignboard"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000"
      },
      "package": "com.yourname.digitalsignboard",
      "permissions": [],
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {},
    "platforms": ["ios", "android", "web"],
      "assetBundlePatterns": [
      "**/*"
    ],
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#000000"
    },
    "androidNavigationBar": {
      "barStyle": "light-content",
      "backgroundColor": "#000000"
    }
  }
}
